# Copy to .env. The server and the web dev server both read it from the repo root.
# The README's "Configuration" section explains each variable.

# Gemma on the Gemini API, for key facts, summaries and Suggest query. Free key:
# https://aistudio.google.com/apikey. Searches, pulls and the feed work without it.
GOOGLE_GENERATIVE_AI_API_KEY=
# Mastra model-router id, provider/model, e.g. google/gemma-4-31b-it
ENZYME_MODEL=google/gemma-4-26b-a4b-it

# API port; the web dev server proxies /api to it
PORT=3210
# Web dev server; WEB_HOST=0.0.0.0 listens on all interfaces (e.g. to reach it from outside a VM)
WEB_PORT=5173
WEB_HOST=localhost

# SQLite database, relative to the repo root
DATABASE_PATH=./data/enzyme.db
# Mastra traces of every agent run, a separate local SQLite file; read with `pnpm traces`
TRACES_PATH=./data/mastra.db
