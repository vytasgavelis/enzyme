{
  "name": "enzyme",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "epmc": "pnpm --filter @enzyme/server epmc",
    "cards": "pnpm --filter @enzyme/server cards",
    "traces": "pnpm --filter @enzyme/server traces",
    "bench": "pnpm --filter @enzyme/server bench",
    "db:generate": "pnpm --filter @enzyme/server db:generate",
    "db:studio": "pnpm --filter @enzyme/server db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
